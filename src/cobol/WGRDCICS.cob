000244 PROCEDURE DIVISION.
000245 0000-MAIN SECTION.
000246     ACCEPT WS-TABLE-PATH FROM ENVIRONMENT "WGRD_CICS_TABLE"
000247     ACCEPT WS-BATCH-PATH FROM ENVIRONMENT "WGRD_CICS_BATCH"
000248     ACCEPT WS-JOURNAL-PATH FROM ENVIRONMENT "WGRD_CICS_JOURNAL"
000249     ACCEPT WS-REPORT-PATH FROM ENVIRONMENT "WGRD_CICS_REPORT"
000250     IF WS-TABLE-PATH = SPACES OR WS-BATCH-PATH = SPACES
000251         DISPLAY "WGRDCICS: PATH CONTROL CARD MISSING"
000252         DISPLAY "WGRD_CICS_TABLE AND WGRD_CICS_BATCH REQUIRED"
000253         MOVE 12 TO RETURN-CODE
000254         STOP RUN
000255     END-IF
000256 
000257     OPEN INPUT TABLE-FILE
000258     IF WS-TABLE-STATUS NOT = "00"
000259         DISPLAY "WGRDCICS: ARMOR TABLE WILL NOT OPEN "
000260             WS-TABLE-STATUS
000261         MOVE 12 TO RETURN-CODE
000262         STOP RUN
000263     END-IF
000264     PERFORM 1000-LOAD-TABLE
000265     CLOSE TABLE-FILE
000266 
000267     OPEN INPUT BATCH-FILE
000268     IF WS-BATCH-STATUS NOT = "00"
000269         DISPLAY "WGRDCICS: BATCH DECK WILL NOT OPEN "
000270             WS-BATCH-STATUS
000271         MOVE 12 TO RETURN-CODE
000272         STOP RUN
000273     END-IF
000274     OPEN OUTPUT JOURNAL-FILE
000275     OPEN OUTPUT REPORT-FILE
000276 
000277     PERFORM 7000-PAGE-HEADING
000278     PERFORM UNTIL WS-BATCH-EOF = "Y"
000279         READ BATCH-FILE INTO WS-BATCH-LAYOUT
000280             AT END MOVE "Y" TO WS-BATCH-EOF
000281             NOT AT END PERFORM 2000-PROCESS-RECORD
000282         END-READ
000283     END-PERFORM
000284     PERFORM 6000-CONTROL-TOTALS
000285 
000286     CLOSE BATCH-FILE JOURNAL-FILE REPORT-FILE
000287 
000288     DISPLAY "WGRDCICS: READ " WS-READ
000289             " ACCEPTED " WS-ACCEPTED
000290             " REJECTED " WS-REJECTED
000291     IF WS-RECON-FLAG NOT = "0"
000292         MOVE 8 TO RETURN-CODE
000293     END-IF
000294     STOP RUN.
000295 
000296 1000-LOAD-TABLE SECTION.
000297     READ TABLE-FILE INTO WS-TABLE-HEADER
000298         AT END PERFORM 9100-TABLE-ABEND
000299     END-READ
000300     IF TC-TYPE NOT = "H"
000301         MOVE "HEADER CARD ABSENT" TO WS-REASON
000302         PERFORM 9100-TABLE-ABEND
000303     END-IF
000304     IF TC-NAME NOT = "ARME-ARMURE"
000305         MOVE "DATASET NAME MISMATCH" TO WS-REASON
000306         PERFORM 9100-TABLE-ABEND
000307     END-IF
000308     IF TC-BUILD NOT = "131544"
000309         MOVE "BUILD IDENTIFICATION MISMATCH" TO WS-REASON
000310         PERFORM 9100-TABLE-ABEND
000311     END-IF
000312     IF TC-ROWS NOT = 65 OR TC-COLS NOT = 35
000313         MOVE "MATRIX DIMENSIONS NOT 65 BY 35" TO WS-REASON
000314         PERFORM 9100-TABLE-ABEND
000315     END-IF
000316     IF TC-TAG = SPACES
000317         MOVE "PROVENANCE TAG ABSENT" TO WS-REASON
000318         PERFORM 9100-TABLE-ABEND
000319     END-IF
000320 
000321     MOVE 0 TO WS-SUM
000322     PERFORM VARYING WS-FAMILY FROM 0 BY 1
000323             UNTIL WS-FAMILY > 64
000324         PERFORM VARYING TR-SEQ FROM 1 BY 1
000325                 UNTIL TR-SEQ > 12
000326             MOVE SPACES TO TABLE-CARD
000327             READ TABLE-FILE INTO WS-TABLE-ROW-CARD
000328                 AT END MOVE "CARD DECK TRUNCATED" TO WS-REASON
000329                        PERFORM 9100-TABLE-ABEND
000330             END-READ
000331             IF TR-TYPE NOT = "R"
000332                 MOVE "ROW CARD TYPE INVALID" TO WS-REASON
000333                 PERFORM 9100-TABLE-ABEND
000334             END-IF
000335             IF TR-FAMILY NOT = WS-FAMILY
000336                 MOVE "FAMILY SEQUENCE BROKEN" TO WS-REASON
000337                 PERFORM 9100-TABLE-ABEND
000338             END-IF
000339             PERFORM 1100-STORE-CARD
000340         END-PERFORM
000341     END-PERFORM
000342 
000343     READ TABLE-FILE
000344         AT END CONTINUE
000345         NOT AT END MOVE "EXTRA CARDS AFTER MATRIX" TO WS-REASON
000346                      PERFORM 9100-TABLE-ABEND
000347     END-READ
000348 
000349     COMPUTE WS-SUM-K =
000350         FUNCTION INTEGER-PART(WS-SUM * 1000 + 0.5)
000351     IF WS-SUM-K < TC-SUM-K - 1 OR WS-SUM-K > TC-SUM-K + 1
000352         MOVE "CONTROL TOTAL DISAGREES WITH DECK" TO WS-REASON
000353         PERFORM 9100-TABLE-ABEND
000354     END-IF
000355     DISPLAY "WGRDCICS: TABLE LOADED 65X35 CONTROL "
000356             WS-SUM-K.
000357 
000358 1100-STORE-CARD SECTION.
000359     COMPUTE WS-ARMOR = (TR-SEQ - 1) * 3
000360     MOVE TR-VALUE-1 TO WS-NUM
000361     PERFORM 1200-STORE-CELL
000362     MOVE TR-VALUE-2 TO WS-NUM
000363     PERFORM 1200-STORE-CELL
000364     IF TR-SEQ < 12
000365         MOVE TR-VALUE-3 TO WS-NUM
000366         PERFORM 1200-STORE-CELL
000367     END-IF.
000368 
000369 1200-STORE-CELL SECTION.
000370     IF WS-ARMOR > 34
000371         MOVE "COLUMN INDEX EXCEEDS 35" TO WS-REASON
000372         PERFORM 9100-TABLE-ABEND
000373     END-IF
000374     IF WS-NUM < 0
000375         MOVE "NEGATIVE ARMOR VALUE REJECTED" TO WS-REASON
000376         PERFORM 9100-TABLE-ABEND
000377     END-IF
000378     IF WS-NUM > 1000
000379         MOVE "ARMOR VALUE OUTSIDE SANITY BAND" TO WS-REASON
000380         PERFORM 9100-TABLE-ABEND
000381     END-IF
000382     ADD WS-NUM TO WS-SUM
000383     MOVE WS-NUM TO WS-CELL(WS-FAMILY + 1, WS-ARMOR + 1)
000384     ADD 1 TO WS-ARMOR.
000385 
000386 2000-PROCESS-RECORD SECTION.
000387     ADD 1 TO WS-READ
000388     MOVE SPACES TO WS-REASON
000389     MOVE "0000" TO WS-REJECT-CODE
000390     EVALUATE TRX-TYPE
000391         WHEN "Z"
000392             PERFORM 2100-CONTROL-CARD
000393         WHEN "D"
000394             ADD 1 TO WS-DATA-READ
000395             PERFORM 2200-DETAIL
000396         WHEN OTHER
000397             ADD 1 TO WS-DATA-READ
000398             MOVE "R001" TO WS-REJECT-CODE
000399             PERFORM 5000-WRITE-REJECT
000400     END-EVALUATE.
000401 
000402 2100-CONTROL-CARD SECTION.
000403     MOVE CTRL-COUNT TO WS-CONTROL-COUNT
000404     MOVE "Y" TO WS-CONTROL-SEEN.
000405 
000406 2200-DETAIL SECTION.
000407     PERFORM 2210-VALIDATE
000408     IF WS-REJECT-CODE = "0000"
000409         PERFORM 2300-SELECT-FAMILY
000410     END-IF
000411     IF WS-REJECT-CODE = "0000"
000412         PERFORM 2400-CALCULATE
000413     END-IF
000414     IF WS-REJECT-CODE = "0000"
000415         PERFORM 4000-WRITE-DETAIL
000416     ELSE
000417         PERFORM 5000-WRITE-REJECT
000418     END-IF.
000419 
000420 2210-VALIDATE SECTION.
000421     IF TRX-MODE NOT = 1 AND TRX-MODE NOT = 2
000422         MOVE "R002" TO WS-REJECT-CODE
000423         EXIT SECTION
000424     END-IF
000425     IF TRX-H IS NOT NUMERIC OR TRX-P IS NOT NUMERIC
000426         OR TRX-K IS NOT NUMERIC OR TRX-C IS NOT NUMERIC
000427         OR TRX-F IS NOT NUMERIC
000428         MOVE "R005" TO WS-REJECT-CODE
000429         EXIT SECTION
000430     END-IF
000431     IF TRX-DIST IS NOT NUMERIC OR TRX-R-BATEAUX IS NOT NUMERIC
000432         OR TRX-R-MAX IS NOT NUMERIC OR TRX-R-TBA IS NOT NUMERIC
000433         OR TRX-R-HA IS NOT NUMERIC OR TRX-R-PROJ IS NOT NUMERIC
000434         MOVE "R005" TO WS-REJECT-CODE
000435         EXIT SECTION
000436     END-IF
000437     IF TRX-MAXHP IS NOT NUMERIC OR TRX-CURHP IS NOT NUMERIC
000438         MOVE "R007" TO WS-REJECT-CODE
000439         EXIT SECTION
000440     END-IF
000441     MOVE TRX-H TO WS-H
000442     MOVE TRX-P TO WS-P
000443     MOVE TRX-K TO WS-K
000444     MOVE TRX-C TO WS-C
000445     MOVE TRX-F TO WS-F
000446     MOVE TRX-DIST TO WS-DIST
000447     MOVE TRX-MAXHP TO WS-MAXHP
000448     MOVE TRX-CURHP TO WS-CURHP
000449     MOVE TRX-ARMOR TO WS-ARMOR
000450     MOVE TRX-ARME TO WS-ARME.
000451 
000452 2300-SELECT-FAMILY SECTION.
000453     IF TRX-PROJ = 0 AND TRX-ARME >= 5 AND TRX-ARME <= 64
000454         AND TRX-EFF NOT = 0
000455         PERFORM 2310-RANGE-BY-CLASS
000456         IF WS-REJECT-CODE = "0000"
000457             PERFORM 2320-KINETIC
000458         END-IF
000459     ELSE
000460         MOVE TRX-FAMILY TO WS-FAMILY
000461     END-IF.
000462 
000463 2310-RANGE-BY-CLASS SECTION.
000464     EVALUATE TRX-CLASS
000465         WHEN 1
000466             MOVE TRX-R-BATEAUX TO WS-RMAX
000467         WHEN 2
000468             MOVE TRX-R-MAX TO WS-RMAX
000469         WHEN 3
000470             MOVE TRX-R-TBA TO WS-RMAX
000471         WHEN 4
000472             MOVE TRX-R-TBA TO WS-RMAX
000473         WHEN 5
000474             MOVE TRX-R-HA TO WS-RMAX
000475         WHEN 6
000476             MOVE TRX-R-PROJ TO WS-RMAX
000477         WHEN OTHER
000478             MOVE "R006" TO WS-REJECT-CODE
000479     END-EVALUATE
000480     IF WS-REJECT-CODE = "0000" AND WS-RMAX = 0
000481         MOVE "R004" TO WS-REJECT-CODE
000482     END-IF.
000483 
000484 2320-KINETIC SECTION.
000485     COMPUTE WS-REM = WS-RMAX - WS-DIST
000486     IF WS-REM < 0
000487         MOVE 0 TO WS-REM
000488     END-IF
000489     COMPUTE WS-QUOT = WS-REM / 13000.0
000490     COMPUTE WS-STEPS = FUNCTION INTEGER-PART(WS-QUOT)
000491     COMPUTE WS-WORK-FAMILY = WS-ARME + WS-STEPS
000492     IF WS-ARME < 34
000493         MOVE 34 TO WS-CAP
000494     ELSE
000495         MOVE 64 TO WS-CAP
000496     END-IF
000497     IF WS-WORK-FAMILY > WS-CAP
000498         MOVE WS-CAP TO WS-WORK-FAMILY
000499     END-IF
000500     IF WS-WORK-FAMILY < 5
000501         MOVE 5 TO WS-WORK-FAMILY
000502     END-IF
000503     MOVE WS-WORK-FAMILY TO WS-FAMILY.
000504 
000505 2400-CALCULATE SECTION.
000506     IF WS-FAMILY > 64
000507         MOVE "R003" TO WS-REJECT-CODE
000508         EXIT SECTION
000509     END-IF
000510     IF WS-ARMOR > 34
000511         MOVE "R008" TO WS-REJECT-CODE
000512         EXIT SECTION
000513     END-IF
000514     MOVE WS-CELL(WS-FAMILY + 1, WS-ARMOR + 1) TO WS-T
000515     MOVE WS-H TO WS-ACC
000516     MULTIPLY WS-P BY WS-ACC
000517     MULTIPLY WS-T BY WS-ACC
000518     MULTIPLY WS-K BY WS-ACC
000519     MULTIPLY WS-C BY WS-ACC
000520     MULTIPLY WS-F BY WS-ACC
000521     MOVE WS-ACC TO WS-AMOUNT
000522     ADD WS-AMOUNT TO WS-RUN-AMOUNT
000523     MOVE "--------" TO J-APPLIED-BITS J-CUR-BITS
000524     IF TRX-MODE = 2
000525         PERFORM 2410-CLAMP
000526     END-IF.
000527 
000528 2410-CLAMP SECTION.
000529     COMPUTE WS-ROOM = WS-MAXHP - WS-CURHP
000530     IF WS-AMOUNT < WS-ROOM
000531         MOVE WS-AMOUNT TO WS-APPLIED
000532     ELSE
000533         MOVE WS-ROOM TO WS-APPLIED
000534     END-IF
000535     COMPUTE WS-NEWHP = WS-CURHP + WS-APPLIED
000536     IF WS-NEWHP < 0
000537         MOVE 0 TO WS-NEWHP
000538     END-IF.
000539 
000540 4000-WRITE-DETAIL SECTION.
000541     ADD 1 TO WS-ACCEPTED
000542     MOVE WS-AMOUNT TO WS-AMT-EDIT
000543     MOVE WS-FAMILY TO WS-FAMILY-EDIT
000544     MOVE WS-ARMOR TO WS-ARMOR-EDIT
000545     MOVE SPACES TO WS-REPORT-LINE
000546     STRING " " TRX-ID "  MODE " TRX-MODE
